@ARTICLE{Erhardt2019-rs,
  title     = "Do transportation network companies decrease or increase
               congestion?",
  author    = "Erhardt, Gregory D and Roy, Sneha and Cooper, Drew and Sana,
               Bhargava and Chen, Mei and Castiglione, Joe",
  abstract  = "This research examines whether transportation network companies
               (TNCs), such as Uber and Lyft, live up to their stated vision of
               reducing congestion in major cities. Existing research has
               produced conflicting results and has been hampered by a lack of
               data. Using data scraped from the application programming
               interfaces of two TNCs, combined with observed travel time data,
               we find that contrary to their vision, TNCs are the biggest
               contributor to growing traffic congestion in San Francisco.
               Between 2010 and 2016, weekday vehicle hours of delay increased
               by 62\% compared to 22\% in a counterfactual 2016 scenario
               without TNCs. The findings provide insight into expected changes
               in major cities as TNCs continue to grow, informing decisions
               about how to integrate TNCs into the existing transportation
               system.",
  journal   = "Sci. Adv.",
  publisher = "American Association for the Advancement of Science (AAAS)",
  volume    =  5,
  number    =  5,
  pages     = "eaau2670",
  month     =  may,
  year      =  2019,
  language  = "en"
}


